{
    "makefile.configureOnOpen": false,
    "rest-client.enableTelemetry": false,
    "rest-client.environmentVariables": {
        "local": {
          "host": "http://localhost:8012",
          "xKey": ""
        },
        "k8s-loc": {
          "host": "http://cezzis-cocktailsmcp.127.0.0.1.sslip.io",
          "xKey": ""
        },
        "k8s-cloudsync": {
          "host": "http://cezzis-cocktailsmcp-cloudsync.127.0.0.1.sslip.io",
          "xKey": ""
        }
    },
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
      "*.go": "$(capture).go.http, $(capture)_test.go"
    },
    "go.toolsEnvVars": {        
      "CGO_LDFLAGS_ALLOW":".*"
    },
    "yaml.schemas": {
        "https://raw.githubusercontent.com/GitTools/GitVersion/main/schemas/6.3/GitVersion.json": "GitVersion.yml"
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/**": true
    }
}